# Copy to android/keystore.properties and fill in. NEVER commit the real file
# or the .jks itself — losing either means you can never update the app on the
# Play Store, and leaking them means someone else can publish as you.
#
# Create the key once (JDK 17 required, keytool ships with it):
#
#   keytool -genkey -v -keystore phoenixx-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias phoenixx
#
# Then back up phoenixx-release.jks somewhere durable and off this machine.

storeFile=../phoenixx-release.jks
storePassword=CHANGE_ME
keyAlias=phoenixx
keyPassword=CHANGE_ME
